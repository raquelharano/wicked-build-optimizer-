# Banco de dados PostgreSQL (Supabase ou Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Cache Redis (Upstash - plano gratuito)
REDIS_URL=""

# Painel admin - defina uma senha forte
ADMIN_PASSWORD="sua-senha-aqui"

# Habilitar scraping automático (recomendado: false em desenvolvimento)
SCRAPE_ENABLED="false"
